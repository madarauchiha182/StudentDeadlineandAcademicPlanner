{
  "version": 2,
  "name": "student-deadline-planner",
  "builds": [
    { "src": "api/*.js", "use": "@vercel/node" },
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "css/*", "use": "@vercel/static" },
    { "src": "js/*", "use": "@vercel/static" },
    { "src": "docs/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/tasks", "dest": "/api/tasks.js" },
    { "src": "/api/alerts", "dest": "/api/alerts.js" },
    { "src": "/api/reports", "dest": "/api/reports.js" },
    { "src": "/api/auth", "dest": "/api/auth.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
